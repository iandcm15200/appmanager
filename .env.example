# APManager Configuration
APMANAGER_BASE_URL=https://api.apmanager.com
APMANAGER_CLIENT_ID=your_client_id
APMANAGER_CLIENT_SECRET=your_client_secret
APMANAGER_TENANT_ID=your_tenant_id

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Application Configuration
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
